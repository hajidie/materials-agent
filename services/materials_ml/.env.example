# Copy to services/materials_ml/.env; fill secrets locally. Never use the platform database/role.
ML_DATABASE_URL=postgresql+psycopg://materials_ml:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/materials_ml
ML_MINIO_ENDPOINT=127.0.0.1:9000
ML_MINIO_BUCKET=materials-ml
ML_MINIO_ACCESS_KEY=materials_ml
ML_MINIO_SECRET_KEY=REPLACE_WITH_DEDICATED_STORAGE_SECRET
ML_MINIO_SECURE=false
# Generate two DIFFERENT random URL-safe tokens, each at least 32 characters. Empty defaults fail closed.
ML_RESOURCE_TOKEN=
ML_WORKER_TOKEN=
# Optional MCP endpoint. When enabled, supply a THIRD distinct random URL-safe token.
ML_MCP_ENABLED=false
# ML_MCP_TOKEN=REPLACE_WITH_A_THIRD_RANDOM_TOKEN
