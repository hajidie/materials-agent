# Local configuration template. Real .env files are ignored by Git.
# Copy values into an ignored local .env only when the corresponding milestone enables them.
# Every credential below is an obvious non-secret placeholder; never commit real credentials.

# Platform
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOCAL_ACTOR_ID=local-actor-placeholder

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=materialsagent
POSTGRES_USER=materialsagent
POSTGRES_PASSWORD=not-a-real-postgres-password

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=not-a-real-minio-access-key
MINIO_SECRET_KEY=not-a-real-minio-secret-key
MINIO_BUCKET=materialsagent-local
MINIO_SECURE=false

# LLM
LLM_ADAPTER=mock
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Tool Runtime
ZTA35G_RUNTIME_MODE=mock
ZTA35G_RUNTIME_URL=http://127.0.0.1:8100
ZTA35G_RUNTIME_TOKEN=not-a-real-runtime-token
ZTA35G_RUNTIME_TIMEOUT_SECONDS=10
M5_DEV_ROUTES_ENABLED=false
# Set a unique local secret of at least 32 UTF-8 bytes; never commit the real value.
TIMELINE_CURSOR_SIGNING_KEY=replace-with-a-unique-local-secret-at-least-32-bytes
