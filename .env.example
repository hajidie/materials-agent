# Local configuration template. Real .env files are ignored by Git.
# Copy values into an ignored local .env only when the corresponding milestone enables them.
# Every credential below is an obvious non-secret placeholder; never commit real credentials.

# Platform
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOCAL_ACTOR_ID=local-actor-placeholder

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=materialsagent
POSTGRES_USER=materialsagent
POSTGRES_PASSWORD=not-a-real-postgres-password

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=not-a-real-minio-access-key
MINIO_SECRET_KEY=not-a-real-minio-secret-key
MINIO_BUCKET=materialsagent-local
MINIO_SECURE=false

# LLM
LLM_ADAPTER=mock
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Tool Runtime
ZTA35G_RUNTIME_MODE=mock
ZTA35G_RUNTIME_URL=http://127.0.0.1:8100
ZTA35G_RUNTIME_TOKEN=not-a-real-runtime-token
ZTA35G_RUNTIME_TIMEOUT_SECONDS=1200
EBSD_MODEL_ROOT=
M5_DEV_ROUTES_ENABLED=false
ENABLE_DEV_FAKE_SIDE_EFFECT_TOOL=false

# Optional local/test ML MCP foundation (never enables production Side-effect Tools)
ENABLE_DEV_MATERIALS_ML_TOOLS=false
ENABLE_MATERIALS_ML_RESOURCES=false
ENABLE_MATERIALS_ML_RESOURCE_CONTEXT=false
MATERIALS_ML_MCP_URL=http://127.0.0.1:8200/mcp
MATERIALS_ML_BINDING_VERSION=1
MATERIALS_ML_MCP_TOKEN=
MATERIALS_ML_RESOURCE_TOKEN=

# Bounded AgentRun budgets (snapshotted at creation)
AGENT_MAX_ACTION_STEPS=12
AGENT_MAX_TOOL_EXECUTIONS=4
AGENT_MAX_ACTIVE_SECONDS=3600
AGENT_MAX_LLM_TOKENS=32000
AGENT_STANDARD_TIMEOUT_SECONDS=10
