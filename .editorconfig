root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{ts,tsx,js,jsx,vue}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
